[project]
entrypoint = "index.html"
requires = [ "nodejs-24" ]
template = "native-static"
version = "0.0.27"

[dev]
build = [ "pnpm", "install" ]
run = [ "sh", "-c", "node server.js" ]

[deploy]
build = [ "sh", "-c", "command -v pnpm >/dev/null 2>&1 && pnpm install || npm install --omit=dev" ]
run = [ "sh", "-c", "test -d node_modules || npm install --omit=dev; exec node server.js" ]
